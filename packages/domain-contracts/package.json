{
  "name": "@fcm/domain-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript contracts between apps/web and apps/api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "tsx": "4.19.2"
  }
}
