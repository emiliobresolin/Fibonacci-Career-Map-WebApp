// FCM API — Prisma schema. Story 2-1 introduces the identity baseline
// (Organization / User / RoleAssignment) and drops the Story 1-4 placeholder.
//
// Conventions:
//   • Logical schema (Arch §6.1): no microservice DB-per-service.
//   • UUIDs as primary keys (client-generated via @default(uuid())) so the
//     migration role does NOT need pgcrypto / CREATE EXTENSION privilege.
//   • Snake_case in the DB (matches Postgres convention + audit_events JSONB
//     diffs), camelCase in TypeScript via @map / @@map.
//   • Tenant-scoped tables carry organization_id NOT NULL (Arch §6.1) and are
//     indexed on it (AC2). RLS policies land in Story E2.6.
//   • Future schema changes must go through `prisma migrate dev --name <slug>`.
//     The Story 1-4 hand-written init migration was the ONE exception (no
//     local Postgres existed yet); Story 2-1's migration is also currently
//     hand-written because the same constraint still applies, but EPIC-2 work
//     past this story will use the Prisma CLI workflow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// Per-organization role assignment. PRD §4.2 allows a user to hold exactly
/// one of {EMPLOYEE, MANAGER, ADMIN} within an Organization, with the dual
/// Admin+Employee exception (a second row in role_assignments). The composite
/// unique on (user_id, organization_id, role) is what enforces "at most one
/// row per role per org per user."
enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

/// Organizational rollout mode (PRD §8.9). New organizations start in
/// CALIBRATION — promotion endpoints reject with structured errors so HR
/// can shadow-run scoring without committed promotions. Transition to
/// ACTIVE is Admin-only and captures a Bootstrap Eligibility Snapshot
/// (Story E7.10 / E13).
enum PromotionMode {
  CALIBRATION
  ACTIVE
}

/// Default visibility posture per organization (PRD §8.6). Defaults to
/// OWN_ONLY for new orgs (PRD §14.2).
enum VisibilityDefault {
  OWN_ONLY
  TEAM
  ORG_SUMMARY
  ORG_FULL
}

/// Default approval-workflow shape per organization (PRD §8.7). Per-level
/// overrides land in Story E7.7.
enum ApprovalWorkflow {
  SINGLE
  DUAL_MANAGER
  HR_GATE
}

/// Evidence type a Requirement expects (PRD §8.4). Determines which
/// upload / submission surface the employee gets and how the evidence
/// row stores its payload (text JSONB vs storage object key).
enum EvidenceType {
  FILE
  URL
  TEXT
  STRUCTURED
}

// ─── Models ──────────────────────────────────────────────────────────────────

/// Tenant root. Every tenant-scoped table FKs back here via organization_id.
/// `oidc_config` is nullable so a new org can be provisioned before its OIDC
/// integration is configured — bootstrap admin fallback credentials (Story E2.7)
/// cover the auth gap until then.
model Organization {
  id                       String             @id @default(uuid()) @db.Uuid
  slug                     String             @unique
  name                     String
  oidcConfig               Json?              @map("oidc_config")
  visibilityDefault        VisibilityDefault  @default(OWN_ONLY) @map("visibility_default")
  approvalWorkflowDefault  ApprovalWorkflow   @default(SINGLE) @map("approval_workflow_default")
  promotionMode            PromotionMode      @default(CALIBRATION) @map("promotion_mode")
  promotionModeChangedAt   DateTime?          @map("promotion_mode_changed_at") @db.Timestamptz
  /// Actor who flipped promotion_mode. Nullable for the initial CALIBRATION
  /// state (no actor) and references a user via UUID without a FK constraint
  /// to avoid a circular dependency: the very first user is created BEFORE
  /// they perform any rollout-mode action, but in non-bootstrap scenarios
  /// the writer (Story E7.10) sets this to a real user_id.
  promotionModeChangedBy   String?            @map("promotion_mode_changed_by") @db.Uuid
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  users                    User[]
  roleAssignments          RoleAssignment[]
  bootstrapCredential      BootstrapCredential?
  recoveryCodes            RecoveryCode[]
  recalcJobs               RecalcJob[]
  careerTracks             CareerTrack[]
  levels                   Level[]
  layers                   Layer[]
  requirements             Requirement[]
  promotionRules           PromotionRule[]

  @@map("organizations")
}

/// Authenticated identity. PRD §4.2: a user belongs to one "home" Organization
/// but their RBAC is fully expressed through RoleAssignment rows. The unique
/// constraint on (organization_id, email) is what allows multi-tenant
/// installations to have the same person at two orgs without an email
/// collision; a future cross-org-identity story can lift this.
model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String
  displayName    String   @map("display_name")
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roleAssignments  RoleAssignment[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

/// Append-only audit log (Arch §6.4 + §9.3, AD-7, NFR-5.1, NFR-5.2). Every
/// state-mutating domain operation eventually lands here via the outbox-relay
/// worker (Story 3-3). The table is RANGE-partitioned by `occurred_at` (monthly)
/// at the DB level — Prisma doesn't model partitions natively, so the migration
/// hand-rolls the PARTITION BY clause + monthly child tables + the BEFORE
/// UPDATE/DELETE/TRUNCATE triggers (ENABLE ALWAYS) that enforce append-only
/// regardless of connecting role or session_replication_role. The app DB
/// role's INSERT+SELECT-only permission is the primary enforcement; the
/// triggers are defense-in-depth.
///
/// `before`/`after` JSONB capture the pre- and post-state snapshot for any
/// mutation (not a diff — full state of the affected entity, to keep
/// reconstruction cheap and self-contained). Both are nullable: pure-creation
/// events leave `before` null, deletion events leave `after` null, and read
/// events leave both null. GIN(jsonb_path_ops) indexes on both columns make
/// field-level investigations via @> containment queries cheap.
///
/// Note on the composite primary key: PostgreSQL requires the partition
/// key (`occurred_at`) to be part of every unique constraint on a
/// partitioned table, hence `@@id([id, occurredAt])` rather than a single
/// `id @id`. Lookups by `id` alone are unusual for an audit log — queries
/// typically scan `(organization_id, occurred_at)` ranges.
model AuditEvent {
  id              String   @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  /// Nullable for system-actor events (cron jobs, outbox relay, GC sweeps)
  /// that have no human originator. The outbox-relay row that produced this
  /// event always carries the originating actor when one exists.
  actorId         String?  @map("actor_id") @db.Uuid
  eventType       String   @map("event_type")
  entityType      String   @map("entity_type")
  /// Nullable so we can record events that operate on a synthetic
  /// org-scope target (e.g., bulk admin actions) without a single row id.
  entityId        String?  @map("entity_id") @db.Uuid
  before          Json?
  after           Json?
  reason          String?
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@id([id, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}

/// Transactional outbox (Arch §9.3, AD-7). Every state-mutating domain
/// operation inserts a row here **in the same DB transaction** as the
/// business mutation. The outbox-relay worker (Story 3-3) consumes rows
/// via Postgres LISTEN/NOTIFY (no polling), writes to `audit_events`,
/// fans out realtime events via Redis pub/sub, enqueues downstream jobs,
/// and finally marks `publishedAt = NOW()`.
///
/// pg_notify only fires at COMMIT time — if the business txn rolls back,
/// the outbox row disappears with it and no notification is sent. That
/// is the outbox pattern's atomicity guarantee.
///
/// `published_at` is the only mutable column post-insert; the relay worker
/// uses an UPDATE to mark fanout completion. Unlike `audit_events` this
/// table is NOT append-only — it's a transactional queue, and Story 3-6's
/// maintenance cron archives + deletes old published rows.
model OutboxEvent {
  eventId         String    @id @default(uuid()) @map("event_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  aggregateType   String    @map("aggregate_type")
  aggregateId     String    @map("aggregate_id") @db.Uuid
  eventType       String    @map("event_type")
  payload         Json
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt     DateTime? @map("published_at") @db.Timestamptz

  @@index([publishedAt(sort: Asc), createdAt])
  @@map("outbox_events")
}

/// Per-(user, organization) role row. PRD §4.2 + Arch §10.2: a user can hold
/// exactly one of {EMPLOYEE, MANAGER, ADMIN} within an Organization, with the
/// dual-role carve-out for Admin+Employee enforced by the composite unique
/// allowing two distinct (user_id, organization_id, role) tuples with the same
/// (user_id, organization_id) prefix.
///
/// Soft-deactivation: a role revocation sets `deactivatedAt` rather than
/// destroying the row, so audit_events can still reference the original
/// role_assignment.id long after the role was rescinded. The composite-unique
/// constraint is enforced as a PARTIAL unique index (active rows only) in the
/// migration — Prisma doesn't model partial indexes natively, so this schema
/// declares the unique shape and the SQL migration adds `WHERE deactivated_at
/// IS NULL` by hand. Re-granting a previously-revoked role is therefore a
/// fresh INSERT, not a re-activation, preserving the audit trail.
model RoleAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  role            Role
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The @@unique here is what Prisma uses to type composite-key accessors
  // (upsert / findUnique). The DB-level constraint is a PARTIAL unique index
  // (see migration.sql) so deactivated rows can coexist with a new active
  // assignment for the same (user, org, role).
  @@unique([userId, organizationId, role])
  @@index([organizationId])
  @@index([userId])
  @@index([deactivatedAt])
  @@map("role_assignments")
}

/// Bootstrap-admin credentials (Story 2-7, PRD FR-1.2). Used to log in
/// the first organization admin before OIDC is configured AND as a
/// fallback during OIDC outages. Self-disables once the first OIDC-linked
/// admin sign-in succeeds — `disabledAt` is set inside the OIDC callback
/// transaction. A disabled row is left in place for forensics.
///
/// `passwordHash` is a scrypt-format string (see BootstrapCredentialsService);
/// the plaintext password is surfaced ONCE at provisioning and never stored.
model BootstrapCredential {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @unique @map("organization_id") @db.Uuid
  username        String
  passwordHash    String    @map("password_hash")
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, username])
  @@map("bootstrap_credentials")
}

/// Recalc-job idempotency registry (Story 4-3, Arch §7.3, FR-5.9).
/// One row per (employee_id, triggering_event_id) — duplicate recalcs
/// for the same business event short-circuit at claim() rather than
/// producing duplicate score snapshots.
///
/// `triggeringEventId` is the outbox_events.event_id that produced the
/// recalc (evidence approval, role change, configuration change, etc.).
/// No FK to outbox_events because outbox rows may be archived before
/// the recalc completes (Story 3-6 maintenance cron).
///
/// `status` is TEXT with a DB-level CHECK constraint rather than a
/// native enum so future variants (cancelled / superseded) don't
/// require an ALTER TYPE migration.
model RecalcJob {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  employeeId           String    @map("employee_id") @db.Uuid
  triggeringEventId    String    @map("triggering_event_id") @db.Uuid
  status               String    @default("pending")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt          DateTime? @map("completed_at") @db.Timestamptz
  failureReason        String?   @map("failure_reason")

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, triggeringEventId])
  @@index([organizationId])
  @@index([status])
  @@map("recalc_jobs")
}

// ─── Configuration domain (Story 6-2) ────────────────────────────────────────

/// Career track within an organization (PRD §8.1, Arch §6.2). Tracks
/// don't cross org boundaries (the unique on (organization_id, slug)
/// is the load-bearing constraint here, not the global slug). A track
/// is the top of the configuration tree: track → levels → layers →
/// requirements; promotion_rules attach to levels.
///
/// `displayOrder` is a per-org integer used to render tracks in a
/// stable sequence (left-to-right on the map's "spiral arms"). Two
/// tracks may share the same display_order — the UI breaks ties by
/// `slug` ascending; we don't enforce uniqueness because the cost of
/// "you can't reorder mid-flight" is much higher than two visually
/// adjacent equal-ordered rows.
model CareerTrack {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  slug            String
  name            String
  description     String?
  displayOrder    Int      @default(0) @map("display_order")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levels          Level[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("career_tracks")
}

/// Level within a career track (PRD §8.2). Score band start/end are
/// inclusive integer bounds; the non-overlap invariant within a
/// (career_track_id, active=true) scope is enforced at the DB layer
/// via a GiST EXCLUDE constraint built in the migration (Prisma can't
/// model exclusion constraints natively, so the migration hand-rolls
/// the `CREATE EXTENSION IF NOT EXISTS btree_gist` + `EXCLUDE USING
/// GIST ... WHERE active = true` clause).
///
/// `levelCode` (e.g. "L1", "L2", or org-custom "Staff", "Senior") is
/// the operator-friendly identifier. Unique within a track.
///
/// Bands are inclusive on both ends; the constraint converts them to
/// `int4range(score_band_start, score_band_end, '[]')` so `[0, 100]`
/// and `[100, 200]` would overlap (rejected). Operators define
/// half-open bands as `[0, 99]` and `[100, 200]` if needed.
model Level {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  careerTrackId    String   @map("career_track_id") @db.Uuid
  levelCode        String   @map("level_code")
  name             String
  scoreBandStart   Int      @map("score_band_start")
  scoreBandEnd     Int      @map("score_band_end")
  displayOrder     Int      @default(0) @map("display_order")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  careerTrack      CareerTrack     @relation(fields: [careerTrackId], references: [id], onDelete: Cascade)
  layers           Layer[]
  promotionRule    PromotionRule?

  @@unique([careerTrackId, levelCode])
  @@index([organizationId])
  @@index([careerTrackId])
  @@map("levels")
}

/// Layer within a level (PRD §8.3). Default seed is Capability /
/// Delivery / Influence but layer names are fully configurable per
/// level. Unique within a level by name.
model Layer {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  levelId         String   @map("level_id") @db.Uuid
  name            String
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  level           Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  requirements    Requirement[]

  @@unique([levelId, name])
  @@index([organizationId])
  @@index([levelId])
  @@map("layers")
}

/// Requirement within a layer (PRD §8.4). `weight` is a positive
/// integer (Fibonacci default at seed time); `mandatory` gates
/// Readiness; `expiryMonths` is nullable — null means evidence for
/// this requirement does not expire.
model Requirement {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  layerId         String       @map("layer_id") @db.Uuid
  name            String
  description     String?
  evidenceType    EvidenceType @map("evidence_type")
  weight          Int
  mandatory       Boolean      @default(false)
  expiryMonths    Int?         @map("expiry_months")
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  layer           Layer        @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([layerId])
  @@map("requirements")
}

/// Promotion rule per level (PRD §8.5). Exactly one row per level
/// (`level_id` unique). Defaults at the schema layer mirror the PRD
/// defaults so a fresh seed produces working configuration without
/// the seeder having to know which column gets which default.
///
/// `blockerCheck = true` makes the eligibility evaluator (§7.5
/// condition 4) consult `employee_blockers` for an active row before
/// flagging the employee Eligible. Per-level override allows orgs to
/// disable the blocker check for early-career levels where blockers
/// are extremely rare.
model PromotionRule {
  id                       String   @id @default(uuid()) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  levelId                  String   @unique @map("level_id") @db.Uuid
  minScore                 Int      @map("min_score")
  minTimeAtLevelMonths     Int?     @map("min_time_at_level_months")
  mandatoryCompletion      Boolean  @default(true) @map("mandatory_completion")
  managerRequired          Boolean  @default(true) @map("manager_required")
  hrRequired               Boolean  @default(false) @map("hr_required")
  blockerCheck             Boolean  @default(true) @map("blocker_check")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  level                    Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("promotion_rules")
}

/// OIDC-outage recovery codes (Story 2-7, PRD FR-1.2). 10 single-use codes
/// generated per organization at bootstrap, bound to admin role only.
/// `codeHash` is a scrypt-format hash of the plaintext code; the plaintext
/// is surfaced ONCE at issuance and is irretrievable thereafter. A code
/// self-burns on redemption — `redeemedAt` + `redeemedByUserId` are set
/// and the row is permanently unusable.
model RecoveryCode {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  codeHash          String    @map("code_hash")
  redeemedAt        DateTime? @map("redeemed_at") @db.Timestamptz
  redeemedByUserId  String?   @map("redeemed_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("recovery_codes")
}
