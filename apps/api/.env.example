# apps/api/.env.example — Copy to apps/api/.env and fill in for local development.
# The real .env is .gitignore'd at the repo root; never commit secrets here.
# Use clearly-placeholder values below; never paste a real credential into this file.
#
# Story 1-4 bootstraps DATABASE_URL only. Subsequent stories will add:
#   REDIS_URL (E4 — BullMQ + cache)
#   S3_*, AWS_* (E8 — evidence storage)
#   OIDC_* (E2 — auth)
#   SENTRY_DSN (E1.7 — observability)

# Mode selection — Story 1-2 dual-mode bootstrap.
API_MODE=api
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection string for Prisma. Local dev format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Production reads this from the cloud secret manager (Arch §12.3, §12.6); never commit a real value.
# Optional query parameters to set in production:
#   ?connection_limit=10&pool_timeout=20  (tune to (Postgres max_connections / pod count))
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>?schema=public
