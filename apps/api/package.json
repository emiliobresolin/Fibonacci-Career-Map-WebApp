{
  "name": "@fcm/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API + worker — modular monolith. Single codebase, two process modes (API_MODE=api|worker).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:api": "cross-env API_MODE=api node dist/main.js",
    "start:worker": "cross-env API_MODE=worker node dist/main.js",
    "test": "node --test",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fcm/domain-contracts": "workspace:*",
    "@fcm/scoring-core": "workspace:*",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "bullmq": "5.34.10",
    "ioredis": "5.4.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.55.3",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.1",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-node": "0.57.1",
    "@opentelemetry/semantic-conventions": "1.28.0",
    "@prisma/client": "5.22.0",
    "@sentry/node": "8.47.0",
    "jose": "5.9.6",
    "openid-client": "5.7.1",
    "nestjs-pino": "4.4.0",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "prisma": "5.22.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "cross-env": "7.0.3",
    "pino-pretty": "11.3.0",
    "tsx": "4.19.2"
  }
}
